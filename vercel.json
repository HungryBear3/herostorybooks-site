{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.herostorybooks.com"
        }
      ],
      "destination": "https://herostorybooks.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fulfillment-sweep",
      "schedule": "*/10 * * * *"
    }
  ]
}
